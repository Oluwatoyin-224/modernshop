# ---- Supabase (frontend - safe to expose) ----
# These are public anon keys, safe for client-side code.
# They are already set in your project's .env file.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ---- Mailgun (server-side only - stored as Edge Function secrets) ----
# Do NOT put these in .env or frontend code.
# Set these using the Supabase dashboard:
#   Project Settings > Edge Functions > Secrets
#
# MAILGUN_API_KEY=your-mailgun-api-key
# MAILGUN_DOMAIN=your-mailgun-domain (e.g. mail.yourdomain.com)
# MAILGUN_FROM_EMAIL=orders@yourdomain.com
